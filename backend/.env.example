# Database — PostgreSQL connection string used by SQLAlchemy and Alembic.
# See backend/README.md Section 2 for full DB configuration details.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/edunexus

# Application
APP_ENV=dev                                # dev | production
APP_DEBUG=true                             # Enable debug mode (disable in production)
APP_SECRET_KEY=change_this_to_a_random_string  # Used for JWT signing. Generate a real secret for production.

# JWT — Optional overrides (defaults are set in app/config.py)
# ACCESS_TOKEN_EXPIRE_MINUTES=60           # Token lifetime in minutes (default: 60)
# JWT_ALGORITHM=HS256                      # JWT signing algorithm (default: HS256)

# AI — Gemini (free tier, used by default if set) or OpenAI for lesson/quiz generation.
# Get a free Gemini key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=sk-...

# CORS — Comma-separated origins allowed to call the API.
# Default matches the Next.js dev server.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Testing — PostgreSQL connection string for the test database.
# Create this database locally: CREATE DATABASE edunexus_test;
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/edunexus_test
